# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard → Project Settings → API (or "API Keys").

# --- Public (shipped to the browser; safe by design, protected by RLS) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Secret / service-role key: bypasses RLS. Used only in server-only modules.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional payment gateways (leave empty until merchant accounts are approved) ---
# Each method stays disabled at checkout until its credentials are set AND it is enabled in Admin → Settings.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# --- WhatsApp Business Cloud API (Meta). Server only. Leave empty until set up. ---
# Without the token and phone number ID, order messages stay queued and are never reported as sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: lets Admin → WhatsApp check which templates Meta has approved.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Delivery receipts: webhook URL is https://<your-domain>/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
