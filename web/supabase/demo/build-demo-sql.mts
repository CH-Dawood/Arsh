// Builds supabase/demo/demo-catalog.sql from the storefront's demo catalogue.
// Run from web/:  node supabase/demo/build-demo-sql.mts
// Apply:          npx supabase db query --linked -f supabase/demo/demo-catalog.sql
// Remove later:   npx supabase db query --linked -f supabase/demo/remove-demo-catalog.sql
import { writeFileSync } from "node:fs";
import { demoBanners, demoBrands, demoCollections, demoProducts } from "../../src/lib/catalog/demo.ts";

const q = (v: string | number | boolean | null | undefined) =>
  v === null || v === undefined ? "null" : typeof v === "string" ? `'${v.replace(/'/g, "''")}'` : String(v);

const sql: string[] = [
  "-- DEMO CATALOGUE (placeholder products, prices and Unsplash photography). Generated by build-demo-sql.mts.",
  "begin;",
];

for (const b of demoBrands) {
  sql.push(`insert into public.brands (name, slug, description, is_featured) values (${q(b.name)}, ${q(b.slug)}, ${q(b.description)}, ${b.isFeatured}) on conflict (slug) do nothing;`);
}

const colors = [...new Set(demoProducts.flatMap((p) => p.variants.map((v) => v.color).filter(Boolean)))] as string[];
sql.push(`insert into public.colors (name) values ${colors.map((c) => `(${q(c)})`).join(", ")} on conflict (name) do nothing;`);

for (const p of demoProducts) {
  sql.push(
    `insert into public.products (name, slug, short_description, description, fabric, embroidery, care_instructions, piece_count, category_id, brand_id, base_price, compare_at_price, is_new_arrival, is_best_seller, is_luxury, created_at)
values (${q(p.name)}, ${q(p.slug)}, ${q(p.shortDescription)}, ${q(p.description)}, ${q(p.fabric)}, ${q(p.embroidery)}, ${q(p.care)}, ${q(p.pieceCount)},
  (select id from public.categories where slug = ${q(p.category.slug)}), (select id from public.brands where slug = ${q(p.brand?.slug)}),
  ${p.price}, ${q(p.compareAtPrice)}, ${p.badges.includes("new")}, ${p.badges.includes("bestseller")}, ${p.badges.includes("luxury")}, ${q(p.createdAt)})
on conflict (slug) do nothing;`,
  );
  p.images.forEach((img, i) =>
    sql.push(`insert into public.product_images (product_id, storage_path, alt, sort_order) select id, ${q(img.url)}, ${q(img.alt)}, ${i} from public.products where slug = ${q(p.slug)} and not exists (select 1 from public.product_images pi join public.products pp on pp.id = pi.product_id where pp.slug = ${q(p.slug)} and pi.storage_path = ${q(img.url)});`),
  );
  for (const v of p.variants) {
    sql.push(`insert into public.product_variants (product_id, size_id, color_id, sku, stock) select p.id, s.id, c.id, ${q(v.sku)}, ${v.stock} from public.products p, public.sizes s, public.colors c where p.slug = ${q(p.slug)} and s.code = ${q(v.size.code)} and c.name = ${q(v.color)} on conflict (sku) do nothing;`);
  }
}

demoBanners.forEach((b, i) =>
  sql.push(`insert into public.banners (heading, subheading, promo_text, cta_label, cta_href, image_path, alt, sort_order) select ${q(b.heading)}, ${q(b.subheading)}, ${q(b.promoText)}, ${q(b.ctaLabel)}, ${q(b.ctaHref)}, ${q(b.image.url)}, ${q(b.image.alt)}, ${i} where not exists (select 1 from public.banners where heading = ${q(b.heading)});`),
);

for (const c of demoCollections) {
  if (c.image) sql.push(`update public.home_sections set image_path = ${q(c.image.url)} where slug = ${q(c.slug)} and image_path is null;`);
}

sql.push("commit;", "");
writeFileSync(new URL("./demo-catalog.sql", import.meta.url), sql.join("\n"));
console.log(`wrote demo-catalog.sql: ${demoProducts.length} products, ${colors.length} colours, ${demoBanners.length} banners`);
